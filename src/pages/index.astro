---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const strip = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

const links = [
	{ glyph: 'md', title: 'Blog', label: `${strip(Astro.site!.href)}/blog`, href: '/blog', external: false },
	{ glyph: 'in', title: 'LinkedIn', label: strip(PROFILE.linkedin), href: PROFILE.linkedin, external: true },
	{ glyph: 'gh', title: 'GitHub', label: strip(PROFILE.github), href: PROFILE.github, external: true },
	{ glyph: '@', title: 'Email', label: PROFILE.email, href: `mailto:${PROFILE.email}`, external: false },
];
---

<!doctype html>
<html lang="en" class="h-full antialiased">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-full flex-col">
		<div class="flex min-h-dvh items-center justify-center px-6 py-[clamp(12px,3.5dvh,48px)] font-sans text-ink antialiased">
			<main class="flex w-full max-w-[460px] flex-col gap-[clamp(18px,3.5dvh,36px)]">
				<header class="flex flex-col items-center gap-[clamp(8px,1.6dvh,16px)]">
					{/*
						The portrait ships with its own recessed neumorphic well on a graphite ground,
						so it sits directly on the page; the mask dissolves the square edges.
					*/}
					<div class="relative size-[clamp(104px,calc(40dvh-184px),232px)] [mask-image:radial-gradient(closest-side,#000_86%,transparent_100%)]">
						<Image
							src={avatar}
							alt={PROFILE.name}
							widths={[232, 464]}
							sizes="232px"
							class="size-full object-cover"
							loading="eager"
							fetchpriority="high"
						/>
					</div>

					<div class="flex flex-col items-center gap-[clamp(10px,1.8dvh,18px)] text-center">
						<h1 class="m-0 text-[clamp(30px,5.2dvh,46px)] leading-[1.02] font-semibold tracking-[-0.035em] text-balance text-ink-strong [text-shadow:0_1px_1px_rgba(0,0,0,0.35)]">
							Think twice,
							<br />
							code once.
						</h1>
						<div class="flex flex-col items-center gap-1.5">
							<div class="text-base font-medium tracking-[-0.01em] text-ink-soft">{PROFILE.name}</div>
							<div class="font-mono text-[11.5px] tracking-[0.1em] text-muted uppercase">{PROFILE.role}</div>
						</div>
						{PROFILE.showAvailability && (
							<div class="flex items-center gap-2 rounded-full bg-surface py-1.75 pr-3.5 pl-3 shadow-inset-sm">
								<span class="size-1.75 rounded-full bg-accent shadow-[0_0_0_3px_rgba(50,145,255,0.2)]"></span>
								<span class="font-mono text-[11px] tracking-[0.06em] text-muted">{PROFILE.availabilityText}</span>
							</div>
						)}
					</div>
				</header>

				<nav class="flex flex-col gap-[clamp(10px,1.8dvh,18px)]">
					{links.map((link) => (
						<a
							href={link.href}
							{...(link.external && { target: '_blank', rel: 'noopener' })}
							class="grid grid-cols-[44px_1fr_auto] items-center gap-4 rounded-[20px] bg-surface px-5.5 py-[clamp(10px,1.8dvh,16px)] text-ink shadow-raised transition-[box-shadow,transform] duration-160 ease-in-out hover:-translate-y-px hover:text-ink hover:shadow-raised-hover active:translate-y-0 active:shadow-pressed"
						>
							<span
								class:list={[
									'flex size-11 items-center justify-center rounded-[13px] bg-surface font-mono font-medium text-ink-icon shadow-inset-md',
									link.glyph === '@' ? 'text-base' : 'text-[15px]',
								]}
							>
								{link.glyph}
							</span>
							<span class="flex min-w-0 flex-col gap-0.75">
								<span class="text-base font-medium tracking-[-0.012em]">{link.title}</span>
								<span class="truncate font-mono text-[11.5px] text-muted">{link.label}</span>
							</span>
							{/* SVG rather than ↗/→ glyphs: iOS renders U+2197 as a colour emoji. */}
							<svg
								width="15"
								height="15"
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-muted-strong"
								aria-hidden="true"
							>
								{link.external ? <path d="M4.5 11.5l7-7M5.5 4.5h6v6" /> : <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />}
							</svg>
						</a>
					))}
				</nav>

				<Footer />
			</main>
		</div>
	</body>
</html>
