---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<header class="mb-[clamp(24px,5dvh,48px)] flex flex-col gap-3">
		<h1 class="m-0 text-[clamp(30px,5.2dvh,44px)] leading-[1.02] font-semibold tracking-[-0.035em] text-ink-strong [text-shadow:0_1px_1px_rgba(0,0,0,0.35)]">
			Blog
		</h1>
		<p class="m-0 text-ink-soft">{SITE_DESCRIPTION}</p>
	</header>

	<ul class="m-0 flex list-none flex-col gap-[clamp(14px,2.4dvh,22px)] p-0">
		{posts.map((post) => (
			<li>
				<a
					href={`/blog/${post.id}/`}
					class="flex flex-col gap-1.5 rounded-[20px] bg-surface px-5.5 py-[clamp(14px,2.2dvh,20px)] text-ink shadow-raised transition-[box-shadow,transform] duration-160 ease-in-out hover:-translate-y-px hover:text-ink hover:shadow-raised-hover active:translate-y-0 active:shadow-pressed"
				>
					<span class="font-mono text-[11px] tracking-[0.1em] text-muted uppercase">
						<FormattedDate date={post.data.pubDate} />
					</span>
					<span class="text-lg font-medium tracking-[-0.015em] text-ink-strong">{post.data.title}</span>
					<span class="text-[15px] text-muted">{post.data.description}</span>
				</a>
			</li>
		))}
	</ul>
</Page>
