---
import { PROFILE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="mx-auto flex w-full max-w-[720px] items-center justify-between gap-4 px-6 pt-[clamp(16px,4dvh,40px)]">
	<a href="/" class="font-mono text-[11.5px] tracking-[0.1em] text-muted uppercase hover:text-ink">
		{PROFILE.name}
	</a>
	<nav class="flex items-center gap-1 rounded-full bg-surface p-1 shadow-inset-sm">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
	</nav>
</header>
