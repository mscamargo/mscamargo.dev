---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="flex min-h-full flex-col font-sans text-ink">
		<Header />
		<main class="mx-auto w-full max-w-[720px] flex-1 px-6 py-[clamp(28px,6dvh,64px)]">
			<slot />
		</main>
		<div class="mx-auto w-full max-w-[720px] px-6 pb-[clamp(20px,5dvh,48px)]">
			<Footer />
		</div>
	</body>
</html>
