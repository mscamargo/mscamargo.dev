---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

const {
	title = 'Marcos S. Camargo',
	description = 'I help companies scale their platforms without scaling costs, incidents or complexity.',
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Hurricane&family=JetBrains+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<Analytics />
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Marcos S. Camargo" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Marcos S. Camargo" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
		<script is:inline>
			// keyboard: backspace goes back, a link's key follows it.
			// j/k/t only do anything on the index: j/k move between posts, t cycles the focused post's tags
			const links = new Map([...document.querySelectorAll('a[data-key]')].map((a) => [a.dataset.key, a]));
			addEventListener('keydown', (e) => {
				if (e.ctrlKey || e.metaKey || e.altKey || e.target.closest('input, textarea, select, [contenteditable]')) return;
				const key = e.key.toLowerCase();
				if (key === 'backspace') return history.back();
				if (links.has(key)) return links.get(key).click();
				const post = document.activeElement.closest('.post');
				if (key === 't' && post) {
					const tags = [...post.querySelectorAll('.tags a')];
					return tags[(tags.indexOf(document.activeElement) + 1) % tags.length]?.focus();
				}
				if (key !== 'j' && key !== 'k') return;
				const titles = [...document.querySelectorAll('.post h2 a')];
				const i = titles.indexOf(post?.querySelector('h2 a'));
				titles[key === 'j' ? Math.min(i + 1, titles.length - 1) : Math.max(i - 1, 0)]?.focus();
			});
		</script>
	</body>
</html>
